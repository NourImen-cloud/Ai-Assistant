# --- LLM Provider (pick one) ---

# groq   = free high-speed cloud tier at https://console.groq.com (Recommended for instant responses)
# ollama = free, runs locally (requires Ollama running)
# openai = paid API
LLM_PROVIDER=groq

# Groq (free tier — https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama settings (default local — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API server
API_HOST=127.0.0.1
API_PORT=8000
