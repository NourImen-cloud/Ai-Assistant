# LLM Provider: 'groq' (super fast, free cloud tier) or 'ollama' (free local)
LLM_PROVIDER=groq

# Groq settings (free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama settings (for local usage)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API server
API_HOST=127.0.0.1
API_PORT=8001

# Gmail Integration (IMAP / SMTP)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
